@inproceedings{huang_aligning_2025,
	address = {Daejeon, South Korea},
	title = {Aligning {Text}-to-{Music} {Evaluation} with {Human} {Preferences}},
	url = {http://arxiv.org/abs/2503.16669},
	doi = {10.48550/arXiv.2503.16669},
	abstract = {Despite significant recent advances in generative acoustic text-to-music (TTM) modeling, robust evaluation of these models lags behind, relying in particular on the popular Fr{\textbackslash}'echet Audio Distance (FAD). In this work, we rigorously study the design space of reference-based divergence metrics for evaluating TTM models through (1) designing four synthetic meta-evaluations to measure sensitivity to particular musical desiderata, and (2) collecting and evaluating on MusicPrefs, the first open-source dataset of human preferences for TTM systems. We find that not only is the standard FAD setup inconsistent on both synthetic and human preference data, but that nearly all existing metrics fail to effectively capture desiderata, and are only weakly correlated with human perception. We propose a new metric, the MAUVE Audio Divergence (MAD), computed on representations from a self-supervised audio embedding model. We find that this metric effectively captures diverse musical desiderata (average rank correlation 0.84 for MAD vs. 0.49 for FAD and also correlates more strongly with MusicPrefs (0.62 vs. 0.14).},
	booktitle = {Proc. of the {Int.} {Society} for {Music} {Information} {Retrieval} {Conf.} ({ISMIR})},
	author = {Huang, Yichen and Novack, Zachary and Saito, Koichi and Shi, Jiatong and Watanabe, Shinji and Mitsufuji, Yuki and Thickstun, John and Donahue, Chris},
	year = {2025},
	keywords = {Computer Science - Artificial Intelligence, Computer Science - Sound, Electrical Engineering and Systems Science - Audio and Speech Processing},
	file = {Preprint PDF:/home/lerch/snap/zotero-snap/common/Zotero/storage/XQS9WMTP/Huang et al. - 2025 - Aligning Text-to-Music Evaluation with Human Preferences.pdf:application/pdf;Snapshot:/home/lerch/snap/zotero-snap/common/Zotero/storage/BBLWPC52/2503.html:text/html},
}

@inproceedings{grotschla_benchmarking_2025,
	address = {Hyderabad, India},
	title = {Benchmarking {Music} {Generation} {Models} and {Metrics} via {Human} {Preference} {Studies}},
	issn = {2379-190X},
	url = {https://ieeexplore.ieee.org/abstract/document/10887745},
	doi = {10.1109/ICASSP49660.2025.10887745},
	abstract = {Recent advancements have brought generated music closer to human-created compositions, yet evaluating these models remains challenging. While human preference is the gold standard for assessing quality, translating these subjective judgments into objective metrics, particularly for text-audio alignment and music quality, has proven difficult. In this work, we generate 6k songs using 12 state-of-the-art models and conduct a survey of 15k pairwise audio comparisons with 2.5k human participants to evaluate the correlation between human preferences and widely used metrics. To the best of our knowledge, this work is the first to rank current state-of-the-art music generation models and metrics based on human preference. To further the field of subjective metric evaluation, we provide open access to our dataset of generated music and human evaluations.},
	urldate = {2025-07-14},
	booktitle = {Proc. of the {Int.} {Conf.} on {Acoustics}, {Speech} and {Signal} {Processing} ({ICASSP})},
	publisher = {IEEE},
	author = {Grötschla, Florian and Solak, Ahmet and Lanzendörfer, Luca A. and Wattenhofer, Roger},
	month = apr,
	year = {2025},
	keywords = {Audio Dataset, Benchmark testing, Computational modeling, Correlation, Data models, Evaluation Metrics, Human Evaluation Survey, Measurement, Multiple signal classification, Music Generation, Open Access, Signal processing, Speech processing, Surveys},
	file = {Full Text PDF:/home/lerch/snap/zotero-snap/common/Zotero/storage/GFPQYY5Q/Grötschla et al. - 2025 - Benchmarking Music Generation Models and Metrics via Human Preference Studies.pdf:application/pdf;PDF:/home/lerch/snap/zotero-snap/common/Zotero/storage/QW53Q5CI/Grötschla et al. - 2025 - Benchmarking Music Generation Models and Metrics via Human Preference Studies.pdf:application/pdf},
}

@inproceedings{reddy_dnsmos_2021,
	address = {Toronto, ON},
	title = {{DNSMOS}: {A} {Non}-{Intrusive} {Perceptual} {Objective} {Speech} {Quality} metric to evaluate {Noise} {Suppressors}},
	shorttitle = {{DNSMOS}},
	url = {http://arxiv.org/abs/2010.15258},
	abstract = {Human subjective evaluation is the “gold standard” to evaluate speech quality optimized for human perception. Perceptual objective metrics serve as a proxy for subjective scores. The conventional and widely used metrics require a reference clean speech signal, which is unavailable in real recordings. Previous no-reference approaches correlate poorly with human ratings and are not widely adopted in the research community. One of the biggest use cases of these perceptual objective metrics is to evaluate noise suppression algorithms. This paper introduces a multi-stage self-teaching based perceptual objective metric that is designed to evaluate noise suppressors. The proposed method generalizes well in challenging test conditions with a high correlation to human ratings.},
	language = {en},
	urldate = {2022-11-12},
	booktitle = {Proc. of the {Int.} {Conf.} on {Acoustics}, {Speech} and {Signal} {Processing} ({ICASSP})},
